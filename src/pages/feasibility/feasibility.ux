<template>
  <div class="page">
    <text class="title">PHASE 1</text>
    <stack class="dial">
      <progress class="arc arc-outer" type="arc" percent="{{ arcPercent }}"></progress>
      <progress class="arc arc-middle" type="arc" percent="48"></progress>
      <progress class="arc arc-inner" type="arc" percent="32"></progress>
      <div class="hand {{ handClass }}"></div>
      <div class="pin"></div>
    </stack>
    <text class="status">ROTATE {{ handAngle }} / ARC {{ arcPercent }}</text>
  </div>
</template>

<script>
export default {
  private: {
    handAngle: 0,
    handClass: 'angle-0',
    arcPercent: 20,
    rotationTimer: null
  },

  onShow() {
    this.rotationTimer = setInterval(() => {
      this.handAngle = (this.handAngle + 30) % 120
      this.handClass = 'angle-' + this.handAngle
      this.arcPercent = this.arcPercent >= 90 ? 20 : this.arcPercent + 10
    }, 1000)
  },

  onDestroy() {
    if (this.rotationTimer) {
      clearInterval(this.rotationTimer)
      this.rotationTimer = null
    }
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}

.title {
  font-size: 26px;
  color: #ffffff;
  margin-bottom: 24px;
}

.dial {
  width: 190px;
  height: 190px;
  position: relative;
  border-width: 8px;
  border-color: #2b2b2b;
  border-radius: 95px;
  align-items: center;
  justify-content: center;
  background-image: url('../../common/logo.png');
  background-size: contain;
  background-position: center;
}

.hand {
  width: 8px;
  height: 80px;
  position: absolute;
  left: 83px;
  top: 15px;
  border-radius: 4px;
  background-color: #ffffff;
  transform-origin: 50% 100%;
}

.arc {
  start-angle: 0deg;
  total-angle: 360deg;
  layer-color: #1d1d1d;
}

.arc-outer {
  width: 190px;
  height: 190px;
  left: -8px;
  top: -8px;
  stroke-width: 8px;
  color: #ff3048;
}

.arc-middle {
  width: 150px;
  height: 150px;
  left: 12px;
  top: 12px;
  stroke-width: 8px;
  color: #9cff00;
}

.arc-inner {
  width: 110px;
  height: 110px;
  left: 32px;
  top: 32px;
  stroke-width: 8px;
  color: #00c8ff;
}


.angle-0 {
  transform: rotate(0deg);
}

.angle-30 {
  transform: rotate(30deg);
}

.angle-60 {
  transform: rotate(60deg);
}

.angle-90 {
  transform: rotate(90deg);
}

.pin {
  width: 22px;
  height: 22px;
  border-radius: 11px;
  background-color: #ff3048;
}

.status {
  font-size: 18px;
  color: #66ef8a;
  margin-top: 24px;
}
</style>
