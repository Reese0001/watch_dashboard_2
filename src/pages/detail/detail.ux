<template>
  <list class="detail-page" bounces="true">
    <list-item type="detail-content" class="detail-content">
      <div class="rect-detail">
        <div class="top-bar">
          <div class="back-btn" onclick="goBack"><text class="back-text">‹</text></div>
          <text class="page-title">健康详情</text>
          <div class="today-badge"><text class="today-text">今日</text></div>
        </div>

        <div class="activity-card">
          <stack class="detail-activity-rings">
            <progress class="detail-ring-base detail-outer" type="arc" percent="100"></progress>
            <progress class="detail-ring-progress move-ring detail-outer" type="arc" percent="{{ movePercent }}"></progress>
            <progress class="detail-ring-base detail-middle" type="arc" percent="100"></progress>
            <progress class="detail-ring-progress exercise-ring detail-middle" type="arc" percent="{{ exercisePercent }}"></progress>
            <progress class="detail-ring-base detail-inner" type="arc" percent="100"></progress>
            <progress class="detail-ring-progress stand-ring detail-inner" type="arc" percent="{{ standPercent }}"></progress>
          </stack>
          <div class="activity-copy">
            <text class="activity-title">运动环</text>
            <div class="activity-line"><div class="legend-dot move-dot"></div><text class="activity-name move-text">活动</text><text class="activity-data">{{ calories }}/{{ caloriesGoal }} 千卡</text><text class="activity-percent move-text">{{ movePercentLabel }}%</text></div>
            <div class="activity-line"><div class="legend-dot exercise-dot"></div><text class="activity-name exercise-text">锻炼</text><text class="activity-data">{{ exerciseMinutes }}/{{ exerciseGoal }} 分钟</text><text class="activity-percent exercise-text">{{ exercisePercentLabel }}%</text></div>
            <div class="activity-line"><div class="legend-dot stand-dot"></div><text class="activity-name stand-text">站立</text><text class="activity-data">{{ standHours }}/{{ standGoal }} 小时</text><text class="activity-percent stand-text">{{ standPercentLabel }}%</text></div>
          </div>
        </div>

        <div class="health-section">
          <div class="section-heading">
            <text class="section-title">健康指标</text>
            <div class="all-normal"><div class="normal-dot"></div><text class="all-normal-text">全部正常</text></div>
          </div>

          <div class="health-detail-item">
            <image class="health-icon-image" src="/common/images/health/heart.png"></image>
            <div class="health-info"><text class="health-name">心率</text><div class="value-row"><text class="health-val">{{ heartRate }}</text><text class="health-unit">BPM</text></div></div>
            <div class="status-pill"><text class="status-text">正常</text></div>
          </div>
          <div class="health-detail-item">
            <image class="health-icon-image" src="/common/images/health/oxygen.png"></image>
            <div class="health-info"><text class="health-name">血氧饱和度</text><div class="value-row"><text class="health-val">{{ bloodOxygen }}</text><text class="health-unit">%</text></div></div>
            <div class="status-pill"><text class="status-text">正常</text></div>
          </div>
          <div class="health-detail-item">
            <image class="health-icon-image" src="/common/images/health/temperature.png"></image>
            <div class="health-info"><text class="health-name">体温</text><div class="value-row"><text class="health-val">{{ temperature }}</text><text class="health-unit">℃</text></div></div>
            <div class="status-pill"><text class="status-text">正常</text></div>
          </div>
        </div>
      </div>

      <div class="round-detail">
        <div class="round-header">
          <div class="round-back-btn" onclick="goBack"><text class="round-back-text">‹</text></div>
          <text class="round-title">健康详情</text>
          <div class="round-status-dot"></div>
        </div>

        <div class="round-activity-card">
          <stack class="round-detail-rings">
            <progress class="round-detail-base round-detail-outer" type="arc" percent="100"></progress>
            <progress class="round-detail-progress move-ring round-detail-outer" type="arc" percent="{{ movePercent }}"></progress>
            <progress class="round-detail-base round-detail-middle" type="arc" percent="100"></progress>
            <progress class="round-detail-progress exercise-ring round-detail-middle" type="arc" percent="{{ exercisePercent }}"></progress>
            <progress class="round-detail-base round-detail-inner" type="arc" percent="100"></progress>
            <progress class="round-detail-progress stand-ring round-detail-inner" type="arc" percent="{{ standPercent }}"></progress>
          </stack>
          <div class="round-activity-copy">
            <text class="round-activity-title">运动环</text>
            <div class="round-activity-line"><div class="round-legend move-dot"></div><text class="round-activity-name">活动</text><text class="round-activity-data">{{ calories }}/{{ caloriesGoal }}</text></div>
            <div class="round-activity-line"><div class="round-legend exercise-dot"></div><text class="round-activity-name">锻炼</text><text class="round-activity-data">{{ exerciseMinutes }}/{{ exerciseGoal }} 分</text></div>
            <div class="round-activity-line"><div class="round-legend stand-dot"></div><text class="round-activity-name">站立</text><text class="round-activity-data">{{ standHours }}/{{ standGoal }} 时</text></div>
          </div>
        </div>

        <div class="round-health-item round-heart-item">
          <image class="round-health-icon" src="/common/images/health/heart.png"></image>
          <text class="round-health-name">心率</text>
          <text class="round-health-value">{{ heartRate }}</text><text class="round-health-unit">BPM</text>
          <text class="round-normal">正常</text>
        </div>
        <div class="round-health-item round-oxygen-item">
          <image class="round-health-icon" src="/common/images/health/oxygen.png"></image>
          <text class="round-health-name">血氧</text>
          <text class="round-health-value">{{ bloodOxygen }}</text><text class="round-health-unit">%</text>
          <text class="round-normal">正常</text>
        </div>
        <div class="round-health-item round-temperature-item">
          <image class="round-health-icon" src="/common/images/health/temperature.png"></image>
          <text class="round-health-name">体温</text>
          <text class="round-health-value">{{ temperature }}</text><text class="round-health-unit">℃</text>
          <text class="round-normal">正常</text>
        </div>
      </div>
    </list-item>
  </list>
</template>

<script>
import router from '@system.router'

export default {
  protected: {
    steps: 4924,
    stepsGoal: 10000,
    calories: 320,
    caloriesGoal: 500,
    exerciseMinutes: 22,
    exerciseGoal: 30,
    standHours: 9,
    standGoal: 12,
    distance: 3.2,
    distanceGoal: 5.0,
    heartRate: 72,
    bloodOxygen: 98,
    temperature: 36.5
  },

  computed: {
    movePercent() { return this.getPercent(this.calories, this.caloriesGoal) },
    exercisePercent() { return this.getPercent(this.exerciseMinutes, this.exerciseGoal) },
    standPercent() { return this.getPercent(this.standHours, this.standGoal) },
    movePercentLabel() { return Math.round(this.movePercent) },
    exercisePercentLabel() { return Math.round(this.exercisePercent) },
    standPercentLabel() { return Math.round(this.standPercent) }
  },

  getPercent(value, goal) {
    const numericGoal = Number(goal)
    if (numericGoal <= 0) return 0
    return Math.max(0, Math.min((Number(value) / numericGoal) * 100, 100))
  },
  goBack() { router.back() }
}
</script>

