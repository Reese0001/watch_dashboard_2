.health-row { height: 46px; border-radius: 23px; background-color: #111318; border-width: 1px; border-color: #24282e; flex-direction: row; align-items: center; padding-left: 15px; padding-right: 18px; }
.health-wide { width: 390px; }.health-mid { width: 374px; }.health-short { width: 350px; }.health-mini { width: 314px; }
.health-icon, .health-glyph { width: 31px; height: 31px; margin-right: 10px; }
.health-icon { object-fit: contain; border-radius: 15px; }.health-glyph { border-radius: 16px; align-items: center; justify-content: center; }
.respiration-glyph { background-color: #76d335; }.hrv-glyph { background-color: #f1a82d; }.glyph-text { color: #ffffff; font-size: 21px; font-weight: bold; }
.health-label { flex: 1; color: #c3c7cd; font-size: 17px; }.health-value { color: #ffffff; font-size: 18px; font-weight: bold; }

.compass-inner { padding-top: 22px; }
.compass-header { width: 360px; height: 32px; }
.compass-dial { width: 336px; height: 336px; }
.compass-scale { width: 336px; height: 336px; object-fit: contain; }
.compass-track { width: 336px; height: 336px; stroke-width: 8px; layer-color: transparent; color: #9ca2aa; start-angle: 0deg; total-angle: 360deg; }
.compass-inner-track { width: 224px; height: 224px; margin-left: 56px; margin-top: 56px; stroke-width: 2px; layer-color: transparent; color: #31363d; start-angle: 0deg; total-angle: 360deg; }
.north-mark { width: 60px; height: 48px; margin-left: 138px; flex-direction: column; align-items: center; }
.north-text { color: #ff354c; font-size: 23px; font-weight: bold; }.north-pointer { width: 8px; height: 15px; border-radius: 4px; background-color: #ff354c; }
.compass-center { width: 180px; height: 120px; margin-left: 78px; margin-top: 106px; flex-direction: column; align-items: center; justify-content: center; }
.direction-name { color: #ffffff; font-size: 47px; font-weight: bold; }.direction-degree { color: #ffffff; font-size: 34px; }
.west-text, .east-text, .south-text { color: #ffffff; font-size: 18px; font-weight: bold; }
